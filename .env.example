# Appwrite project. The API key is only used by the scripts in scripts/.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# The model the residents use. pnpm provision stores it as a secret function variable.
OPENROUTER_API_KEY=
# Optional: a second key, used only when the first one returns 402 (out of credits),
# and a different OpenRouter model. Add them as function variables to use them.
# OPENROUTER_API_KEY_FALLBACK=
# OPENROUTER_MODEL=openai/gpt-6-luna

# Optional: a custom domain for the Site
SITE_DOMAIN=
